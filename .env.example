# Leave this file as .env.example (don't fill it in) to run the app on the
# local test backend — localStorage-backed, seeded with demo orders, no
# Supabase project required. See README.md "Local test mode."
#
# To switch to a real Supabase project: copy this to .env and fill in real
# values below. Once both are set, the app automatically routes every call
# to Supabase instead (src/lib/db.js) — no component code changes needed.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — used by the Express layer in /server, NEVER by the
# React app. Keep this out of anything that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PAYSTACK_SECRET_KEY=sk_live_or_test_xxx
PORT=8787
